# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local ke git.

# ---- Supabase (Dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: RAHASIA, hanya dipakai server-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Gemini AI (https://aistudio.google.com/apikey) ----
# RAHASIA: hanya dipakai server-side, tidak pernah dikirim ke browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Seed data demo (bebas, string acak) ----
SEED_SECRET=temuin-demo-2026
